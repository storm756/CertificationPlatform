# Copy to /srv/csfr/staging/app.env on the server and fill in. NEVER commit the real file.
# Staging has its OWN secret key, database and passwords, and sends mail to Mailpit, never Brevo.
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-different-from-prod
DJANGO_ALLOWED_HOSTS=staging.cyberfirstresponse.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.cyberfirstresponse.io
WEB_CONCURRENCY=2
SITE_DOMAIN=staging.cyberfirstresponse.io
SITE_NAME=Cyber First Response (staging)

DB_HOST=db
DB_NAME=csfr
DB_USER=csfr_app
DB_PASSWORD=change-me

# Mail sink (the mailpit service in the staging stack). View it via: ssh -L 8025:127.0.0.1:8025 deploy@server
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Cyber First Response (staging) <noreply@staging.cyberfirstresponse.io>

SENTRY_DSN=

BACKUP_ENV_NAME=staging
AGE_PUBLIC_KEY=age1...
# Leave BACKUP_REMOTE empty to keep staging backups local only, or reuse the bucket under another prefix.
BACKUP_REMOTE=
