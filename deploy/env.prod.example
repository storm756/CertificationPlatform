# Copy to /srv/csfr/prod/app.env on the server and fill in. NEVER commit the real file.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=cyberfirstresponse.io,www.cyberfirstresponse.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://cyberfirstresponse.io,https://www.cyberfirstresponse.io
WEB_CONCURRENCY=3
SITE_DOMAIN=cyberfirstresponse.io
SITE_NAME=Cyber First Response

# Runtime database role (csfr_app). Same password as DB_APP_PASSWORD in db.env.
DB_HOST=db
DB_NAME=csfr
DB_USER=csfr_app
DB_PASSWORD=change-me

# Brevo SMTP (prod only)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Cyber First Response <noreply@cyberfirstresponse.io>

# Monitoring (docs/runbook.md). All optional: empty means off.
# Sentry error reports (scrubbed, no personal data). A person creates the project and pastes its DSN here.
SENTRY_DSN=
# Heartbeat URLs (e.g. Healthchecks.io): the tasks loop every 10 min, the hourly DB backup, the daily media backup.
TASKS_PING_URL=
BACKUP_DB_PING_URL=
BACKUP_MEDIA_PING_URL=

# Backups (cron container). BACKUP_REMOTE is an rclone path to the B2 bucket.
BACKUP_ENV_NAME=prod
AGE_PUBLIC_KEY=age1...
BACKUP_REMOTE=b2:your-bucket-name
RCLONE_CONFIG_B2_TYPE=s3
RCLONE_CONFIG_B2_PROVIDER=Other
RCLONE_CONFIG_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
RCLONE_CONFIG_B2_ACCESS_KEY_ID=change-me-write-only-key
RCLONE_CONFIG_B2_SECRET_ACCESS_KEY=change-me
