{
	# Certificates come from Let's Encrypt automatically once the DNS A records point here.
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Content-Security-Policy for the learner site. The admin (django-unfold) needs inline styles
# and scripts, so it is not covered here; it is staff-only and behind 2FA.
(csp) {
	@notadmin not path /admin/*
	header @notadmin Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# /media is deliberately NOT served in stage 0. It arrives with the Django forward_auth check.

{$SCHEME}{$PROD_DOMAIN} {
	import common
	import csp
	handle_path /static/* {
		root * /srv/prod/static
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		reverse_proxy web-prod:8000
	}
}

{$SCHEME}www.{$PROD_DOMAIN} {
	redir {$SCHEME}{$PROD_DOMAIN}{uri} permanent
}

{$SCHEME}{$STAGING_DOMAIN} {
	import common
	import csp
	header X-Robots-Tag "noindex, nofollow"
	handle_path /static/* {
		root * /srv/staging/static
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy web-staging:8000
	}
}
