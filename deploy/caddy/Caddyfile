{
	# Certificates come from Let's Encrypt automatically once the DNS A records point here.
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Content-Security-Policy for the learner site. The admin (django-unfold) needs inline styles
# and scripts, so it is not covered here; it is staff-only and behind 2FA.
(csp) {
	@notadmin not path /admin/*
	header @notadmin Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self' https://www.youtube.com; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# /media is never served directly. /learn/media/<id>/ goes to Django, which checks the sign-in and that the
# file belongs to a published unit, then answers with X-Accel-Redirect: Caddy sends that file from the
# read-only media volume with range requests, ETag and Last-Modified (D34, D35). Only Django can reach it.

{$SCHEME}{$PROD_DOMAIN} {
	import common
	import csp
	handle_path /static/* {
		root * /srv/prod/static
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		reverse_proxy web-prod:8000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/prod/media
				rewrite * {rp.header.X-Accel-Redirect}
				copy_response_headers {
					include Cache-Control Content-Disposition X-Content-Type-Options
				}
				file_server
			}
		}
	}
}

{$SCHEME}www.{$PROD_DOMAIN} {
	redir {$SCHEME}{$PROD_DOMAIN}{uri} permanent
}

{$SCHEME}{$STAGING_DOMAIN} {
	import common
	import csp
	header X-Robots-Tag "noindex, nofollow"
	handle_path /static/* {
		root * /srv/staging/static
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy web-staging:8000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/staging/media
				rewrite * {rp.header.X-Accel-Redirect}
				copy_response_headers {
					include Cache-Control Content-Disposition X-Content-Type-Options
				}
				file_server
			}
		}
	}
}
