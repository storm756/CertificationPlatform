{
	# Certificates come from Let's Encrypt automatically once the DNS A records point here.
}

# Security headers. Django sets them on every page it answers (apps/core/security.py: one strict CSP,
# the YouTube player script only on a page with a YouTube film, a separate policy for /admin/ and
# /rosetta/). The "?" means "only if the response has none", so these cover just the files Caddy
# serves itself (/static, /learn/media) and Django's own headers are never doubled or replaced.
# {args[0]} is the HSTS value, which differs between prod and staging.
(common) {
	encode zstd gzip
	header {
		?Strict-Transport-Security "{args[0]}"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "same-origin"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# /media is never served directly. /learn/media/<id>/ goes to Django, which checks the sign-in and that the
# file belongs to a published unit, then answers with X-Accel-Redirect: Caddy sends that file from the
# read-only media volume with range requests, ETag and Last-Modified (D34, D35). Only Django can reach it.

{$SCHEME}{$PROD_DOMAIN} {
	import common "max-age=31536000; includeSubDomains"
	handle_path /static/* {
		root * /srv/prod/static
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		reverse_proxy web-prod:8000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/prod/media
				rewrite * {rp.header.X-Accel-Redirect}
				copy_response_headers {
					include Cache-Control Content-Disposition X-Content-Type-Options
				}
				file_server
			}
		}
	}
}

{$SCHEME}www.{$PROD_DOMAIN} {
	redir {$SCHEME}{$PROD_DOMAIN}{uri} permanent
}

{$SCHEME}{$STAGING_DOMAIN} {
	import common "max-age=300"
	header X-Robots-Tag "noindex, nofollow"
	handle_path /static/* {
		root * /srv/staging/static
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy web-staging:8000 {
			@accel header X-Accel-Redirect *
			handle_response @accel {
				root * /srv/staging/media
				rewrite * {rp.header.X-Accel-Redirect}
				copy_response_headers {
					include Cache-Control Content-Disposition X-Content-Type-Options
				}
				file_server
			}
		}
	}
}
