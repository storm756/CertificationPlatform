# Copy to /srv/csfr/<staging|prod>/db.env (a DIFFERENT set of passwords per environment). NEVER commit the real file.
# Read by the db container (first start only, to create the roles) and by deploy.sh (migrations).
# The web container never sees DB_OWNER_PASSWORD.
POSTGRES_PASSWORD=change-me-superuser
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
